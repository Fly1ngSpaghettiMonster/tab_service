# Copy to .env and fill in. Never commit .env.
# Use letters and digits only (no ; or quotes), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
# Must match EXPO_PUBLIC_TAB_API_KEY in tab_mobile/.env.local. At least 16 characters.
TAB_API_KEY=change-me-at-least-16-chars

# Unlocks the admin dashboard (https://tab.aabder.xyz/view#<this key>): every stored journey.
# Keep it different from TAB_API_KEY (which ships inside the app). At least 32 characters; empty disables it.
TAB_ADMIN_KEY=

TAB_PUBLIC_VIEWER_URL=https://tab.aabder.xyz/view
# Comma-separated, only needed if the viewer runs on a different origin than the API.
TAB_ALLOWED_ORIGINS=
TAB_RETENTION_DAYS=60
TAB_HTTP_PORT=8080
